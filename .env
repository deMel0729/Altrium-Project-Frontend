# Where the browser sends CRM requests. Leave as /api to use the Vite dev proxy
# configured in vite.config.js. Set an absolute URL (e.g. https://localhost:7069/api)
# only if the backend enables CORS for this origin.
VITE_API_URL=https://localhost:7069/api

# Where the Vite dev proxy forwards /api. Matches the backend "http" launch profile.
# Switch to https://localhost:7069 to use the backend's https launch profile.
VITE_PROXY_TARGET=https://localhost:7069
